includes:
    - vendor/cambis/silverstan/extension.neon

parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    silverstan:
        includeTestOnly: true
    ignoreErrors:
        # getDecimalQuantityRules()/hasMethod() are reached through the Buyable *interface* type, but the
        # concrete buyables (Product/Variation) are Extensible DataObjects carrying this module's extension;
        # every call site is hasMethod()-guarded. silverstan can't see an extension method via the interface.
        -
            message: '#Call to an undefined method SilverShop\\Model\\Buyable::(hasMethod|getDecimalQuantityRules)\(\)#'
